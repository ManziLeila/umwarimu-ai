# Node/TanStack Start server (frontend) — see src/lib
GEMINI_API_KEY=

# Signs/encrypts the session cookie AND the stateless OTP token used during
# login. Must be at least 32 characters — h3's session sealing rejects
# anything shorter. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Apps Script backend. APPS_SCRIPT_API_KEY must match the
# APPS_SCRIPT_API_KEY Script Property set in the Apps Script project
# (Apps Script editor > Project Settings > Script Properties).
# APPS_SCRIPT_WEB_APP_URL is the URL printed by `clasp deploy`.
APPS_SCRIPT_WEB_APP_URL=
APPS_SCRIPT_API_KEY=
